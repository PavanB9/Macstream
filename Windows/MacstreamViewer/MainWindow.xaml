<Window x:Class="MacstreamViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macstream"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Flat toolbar buttons: keep their colour, dim when disabled (the default style turned
             a disabled button white with white text). -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border x:Name="TopToolbar" Grid.Row="0" Background="#FF2D2D2D" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Macstream" Foreground="White"
                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="MacAddressLabel" Text="Mac address:" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="HostTextBox" Text="169.254.79.57" Width="140"
                             Background="#FF3C3C3C" Foreground="White" BorderBrush="#FF555555"
                             Padding="5,3" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="PortLabel" Text="Port:" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <TextBox x:Name="PortTextBox" Text="9802" Width="60"
                             Background="#FF3C3C3C" Foreground="White" BorderBrush="#FF555555"
                             Padding="5,3" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="Usb4IpStatusText" Text="Mac: searching..."
                               Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click"
                            Width="92" Height="28" Margin="5,0"
                            Background="#FF007ACC" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click"
                            Width="92" Height="28" Margin="5,0"
                            Background="#FFCC3333" Foreground="White" BorderThickness="0" IsEnabled="False"/>
                    <Button x:Name="MacControlButton" Content="Mac control: On" Click="MacControlButton_Click"
                            Width="128" Height="28" Margin="5,0"
                            Background="#FF2E7D32" Foreground="White" BorderThickness="0"
                            ToolTip="Send this mouse to the Mac while it is over the picture"/>
                    <Button x:Name="ClipboardButton" Content="Clipboard: Off" Click="ClipboardButton_Click"
                            Width="118" Height="28" Margin="5,0"
                            Background="#FF444444" Foreground="White" BorderThickness="0"
                            ToolTip="Copy on one computer, paste on the other (text and pictures). Only new copies cross over; nothing is kept."/>
                    <Button x:Name="FullscreenButton" Content="Fullscreen" Click="FullscreenButton_Click"
                            Width="108" Height="28" Margin="5,0"
                            Background="#FF444444" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="SettingsButton" Content="Settings" Click="SettingsButton_Click"
                            Width="84" Height="28" Margin="5,0"
                            Background="#FF444444" Foreground="White" BorderThickness="0"
                            ToolTip="Clipboard, scrolling, which Mac key Ctrl/Alt/Windows become, pairing"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Display area -->
        <Grid x:Name="DisplayHost" Grid.Row="1" Background="#FF000000"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True">
            <Image x:Name="DisplayImage"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="StatusText" Text="Not connected - start the server on the Mac, then click Connect"
                       Foreground="#FF666666" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Bottom status bar -->
        <Border x:Name="BottomStatusBar" Grid.Row="2" Background="#FF2D2D2D" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="10" Height="10"
                         Fill="#FFCC3333" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="ConnectionStatus" Grid.Column="1" Text="Disconnected"
                           Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock x:Name="FpsText" Grid.Column="2" Text=""
                           Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                <TextBlock x:Name="FrameSizeText" Grid.Column="3" Text=""
                           Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
