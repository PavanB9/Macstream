<?xml version="1.0" encoding="utf-8"?>
<!-- Project-local NuGet configuration: packages are cached inside .local/, only nuget.org is used. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".local/nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
